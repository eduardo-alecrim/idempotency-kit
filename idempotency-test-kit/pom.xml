<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.eduardo-alecrim</groupId>
    <artifactId>idempotency-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>idempotency-test-kit</artifactId>
  <name>idempotency-test-kit</name>
  <description>The TCK: tests that every store and adapter must pass.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.eduardo-alecrim</groupId>
      <artifactId>idempotency-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The contracts are JUnit tests, so their test libraries are compile dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check</id>
            <configuration>
              <!-- Run by the adapter modules; the aggregated report counts it -->
              <excludes>
                <exclude>io/github/eduardoalecrim/idempotency/tck/HttpAdapterContract*</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
