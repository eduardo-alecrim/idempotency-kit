<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.eduardo-alecrim</groupId>
    <artifactId>idempotency-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>idempotency-coverage-report</artifactId>
  <packaging>pom</packaging>
  <name>idempotency-coverage-report</name>
  <description>Aggregated coverage report of every module. Not published.</description>

  <properties>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.eduardo-alecrim</groupId>
      <artifactId>idempotency-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.eduardo-alecrim</groupId>
      <artifactId>idempotency-store-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.eduardo-alecrim</groupId>
      <artifactId>idempotency-store-redis</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.eduardo-alecrim</groupId>
      <artifactId>idempotency-spring-boot-autoconfigure</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.eduardo-alecrim</groupId>
      <artifactId>idempotency-quarkus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.eduardo-alecrim</groupId>
      <artifactId>idempotency-quarkus-deployment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.eduardo-alecrim</groupId>
      <artifactId>idempotency-client</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.eduardo-alecrim</groupId>
      <artifactId>idempotency-test-kit</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Spring and Quarkus trees meet only here; convergence is checked in each module -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <configuration>
              <skip>true</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
